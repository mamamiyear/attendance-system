# 必填：Linear 工作区管理员创建 OAuth 应用后获得
LINEAR_CLIENT_ID=

# 必填：至少 32 字节的随机值，例如：openssl rand -base64 48
SESSION_SECRET=

# 固定为 BoxLite 对外公开地址（不要以 / 结尾）
APP_ORIGIN=https://attendance.example.com

PORT=8080

# 仅这些 Linear 邮箱拥有管理员权限；多个邮箱用逗号分隔
ADMIN_EMAILS=primary@example.com,secondary@example.com
PRIMARY_APPROVER_EMAIL=primary@example.com
SECONDARY_APPROVER_EMAIL=secondary@example.com
PRIMARY_APPROVER_NAME=初审人
SECONDARY_APPROVER_NAME=终审人

# 邮件通知（配置后自动发送；未配置时通知保存在 email_outbox）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=休假助手 <leave@example.com>

# Slack 审批私信。安装 Slack App 后填入 Bot User OAuth Token（xoxb-...）。
# 为 Bot 授予 users:read.email、im:write 和 chat:write。
# 初审、终审邮箱需与 Bot 所在工作区中审批人的 Slack 账号邮箱一致。
SLACK_BOT_TOKEN=
